# از @BotFather بگیر
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# فقط این یوزرآیدی‌ها اجازه دارن (با کاما جدا کن)
# یوزرآیدی خودت: به @userinfobot پیام بده
ALLOWED_USER_IDS=123456789

# مدل Ollama برای تبدیل متن به دستور ترمینال
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# مدل Whisper برای ویس → متن (tiny/base/small/medium)
WHISPER_MODEL=base
WHISPER_LANGUAGE=fa

# حداکثر زمان اجرای دستور (ثانیه)
COMMAND_TIMEOUT=60

# آیا دستورهای تولیدشده توسط مدل بدون تأیید اجرا شوند؟ (خطرناک)
AUTO_EXECUTE_LLM=false

# مسیر ذخیره موقت فایل‌ها
TEMP_DIR=/tmp/conect-bot
